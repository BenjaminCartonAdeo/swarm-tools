{
  "name": "@benjamin/swarmx",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "swarmx": "./dist/bin/swarmx.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "prepare": "bun run build",
    "build": "bun build src/index.ts --outdir dist --target node && bun build bin/swarmx.ts --outdir dist/bin --target node",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.7",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
